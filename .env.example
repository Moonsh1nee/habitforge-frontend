# ─────────────────────────────────────────────────────────────
#  HabitForge Frontend — переменные окружения
#
#  Скопируй этот файл в .env.local и заполни значения:
#    cp .env.example .env.local
#
#  .env.local НЕ коммитится (он в .gitignore).
#  Этот файл (.env.example) коммитится как шаблон.
# ─────────────────────────────────────────────────────────────

# URL бэкенда (FastAPI)
# Локальная разработка: http://localhost:8000
# Продакшн: укажи свой домен, например https://api.habitforge.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL WebSocket-сервера (тот же бэкенд, только ws://)
# Локальная разработка: ws://localhost:8000
# Продакшн: wss://api.habitforge.app
NEXT_PUBLIC_WS_URL=ws://localhost:8000
